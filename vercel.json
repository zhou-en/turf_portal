{
    "version": 2,
    "builds": [
        {
            "src": "turf_portal/wsgi.py",
            "use": "@vercel/python",
            "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "turf_portal/wsgi.py"
        }
    ],
    "env": {
        "DISABLE_SSL": "false"
    }
}
