{
    "version": 2,
    "builds": [
        {
            "src": "turf_portal/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb",
                "runtime": "python3.12"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "turf_portal/wsgi.py"
        }
    ],
    "installCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput"
}
